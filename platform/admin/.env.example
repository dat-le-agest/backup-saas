APP_ENV=dev
# LOG_LEVEL=debug

GIN_PORT=8090

# admin accounts (the platform database); use a role that is not a superuser
DB_DSN=postgres://admin:admin@localhost:5432/admin?sslmode=disable
# signing keys of admin sessions; empty in dev = ephemeral key (sessions end on restart).
# A key directory rotates without restart (docs/runbooks/jwt-key-rotation.md)
# JWT_KEYS_DIR=./jwt-keys
# JWT_PRIVATE_KEY_FILE=./jwt.pem

# first admin account, created when there is none
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-admin-password
# set when served over HTTPS
# ADMIN_SECURE_COOKIE=true
GRAFANA_URL=http://localhost:3030

# managed apps: each app's internal admin URL and its ADMIN_API_KEY
ADMIN_APPS=[{"id":"notes","name":"Notes","admin_url":"http://localhost:9081","public_url":"http://localhost:8081","api_key":"dev-notes-admin-key"}]

# OpenTelemetry (traces + metrics over OTLP/gRPC, e.g. Grafana Alloy); empty disables export
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
