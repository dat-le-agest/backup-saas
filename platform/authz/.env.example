APP_ENV=dev
# LOG_LEVEL=debug

# Postgres from `make deps` (deploy/compose.yaml); use a role that is not a superuser
DB_DSN=postgres://authz:authz@localhost:5432/authz?sslmode=disable
# auto: apply migrations then serve | only: apply and exit | off
# DB_MIGRATE=auto

GIN_PORT=3002
# GIN_MODE=release
# GIN_TRUSTED_PROXIES=10.0.0.0/8
# GIN_WRITE_TIMEOUT=0

# OpenTelemetry (traces + metrics over OTLP/gRPC, e.g. Grafana Alloy); empty disables export
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_TRACES_SAMPLER_ARG=1

# apps served by the platform; each gets its own store (schema) at startup
PLATFORM_APPS=notes
# each app's model: the platform module + apps/<app>/authz/*.fga (paths from platform/authz)
AUTHZ_PLATFORM_MODEL=./model
AUTHZ_APPS_DIR=../../apps
