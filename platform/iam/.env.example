APP_ENV=dev
# LOG_LEVEL=debug

# Postgres from `make deps` (deploy/compose.yaml); use a role that is not a superuser
DB_DSN=postgres://iam:iam@localhost:5432/iam?sslmode=disable
# auto: apply migrations then serve | only: apply and exit | off
# DB_MIGRATE=auto

# optional: publishes membership versions so the gateway rejects stale tokens without calling iam
# REDIS_URL=redis://localhost:6379/0

# required outside dev (dev uses an ephemeral key): openssl genpkey -algorithm ed25519 -out jwt.pem
# JWT_PRIVATE_KEY_FILE=./jwt.pem
# JWT_ISSUER=saas-iam
# JWT_ACCESS_TTL=600

GIN_PORT=3001
# GIN_MODE=release
# GIN_TRUSTED_PROXIES=10.0.0.0/8

# OpenTelemetry (traces + metrics over OTLP/gRPC, e.g. Grafana Alloy); empty disables export
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_TRACES_SAMPLER_ARG=1

# optional: sync memberships (tenant:<id>#<role>@user:<id>) to the central authz service
# AUTHZ_SERVICE_URL=http://localhost:3002

# apps served by the platform (token audiences); registered at startup
IAM_APPS=notes
