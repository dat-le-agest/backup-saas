APP_ENV=dev
# LOG_LEVEL=debug

GIN_PORT=8080
# GIN_MODE=release
# GIN_TRUSTED_PROXIES=10.0.0.0/8

# access tokens issued by iam
JWT_JWKS_URL=http://localhost:3001/.well-known/jwks.json
# JWT_ISSUER=saas-iam
# tokens of every app: the platform gateway serves sign-in and tenants for all apps
JWT_AUDIENCE=*

# optional: membership versions published by iam (same Redis); without it every
# tenant-scoped request asks iam for the current version
# REDIS_URL=redis://localhost:6379/0

# upstream services (http:// = gRPC over h2c)
IAM_SERVICE_URL=http://localhost:3001

# OpenTelemetry (traces + metrics over OTLP/gRPC, e.g. Grafana Alloy); empty disables export
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_TRACES_SAMPLER_ARG=1
