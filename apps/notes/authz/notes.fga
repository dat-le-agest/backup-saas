module notes

# Authorization of the notes app, composed with the platform module
# (platform/authz/model/platform.fga) into the model of the notes store.
# Equivalent to the RBAC policy of the note service (NotePolicy), so switching
# it to ReBAC changes nothing until tuples share more.

# notes: create and list (type-level checks ask the tenant)
extend type tenant
  relations
    define can_create_note: member
    define can_read_note: viewer

# note service: note:<id>#tenant@tenant:<id> and note:<id>#owner@user:<id> on create
type note
  relations
    define tenant: [tenant]
    define owner: [user]
    # an owner keeps editing rights only while still a member of the tenant
    # (a creator demoted to viewer can't edit their old notes, as with RBAC)
    define owner_member: owner and member from tenant
    # [user] / [user, user:*] allow sharing a single note beyond the roles
    define editor: [user] or owner_member or admin from tenant
    define viewer: [user, user:*] or editor or viewer from tenant

    define can_read: viewer
    define can_update: editor
    define can_delete: editor
