APP_ENV=dev
# LOG_LEVEL=debug

GIN_PORT=8081
# GIN_MODE=release
# GIN_TRUSTED_PROXIES=10.0.0.0/8

# the app's own authentication (core/authn): users, tenants, tokens
DB_DSN=postgres://notes_auth:notes_auth@localhost:5432/notes_auth?sslmode=disable
# signing keys of the access tokens; empty in dev = ephemeral key. A key directory
# (make jwt-key keys=./jwt-keys name=...) rotates without restart, see
# docs/runbooks/jwt-key-rotation.md; JWT_PRIVATE_KEY_FILE is a single key
# JWT_KEYS_DIR=./jwt-keys
# JWT_KEYS_RELOAD=60
# JWT_PRIVATE_KEY_FILE=./jwt.pem
# JWT_ISSUER=saas-iam

# optional: caches membership versions (written on every change); without it every
# tenant-scoped request reads the current version from the database
# REDIS_URL=redis://localhost:6379/0

# upstream services (http:// = gRPC over h2c)
NOTE_SERVICE_URL=http://localhost:3000
# NOTE_SERVICE_TIMEOUT=10
# service name the internal tokens are issued for (default: the prefix without -service)
# NOTE_SERVICE_AUDIENCE=note

# signing keys of the internal tokens, the proof of every call to the services
# (their own keys, not the access tokens'); empty in dev = ephemeral key.
# Public keys are served at http://localhost:9081/.well-known/internal-jwks.json
# INTERNAL_JWT_KEYS_DIR=./internal-jwt-keys
# INTERNAL_JWT_ISSUER=saas-iam

# OpenTelemetry (traces + metrics over OTLP/gRPC, e.g. Grafana Alloy); empty disables export
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_TRACES_SAMPLER_ARG=1

# internal admin API for the admin dashboard (never publish this port)
ADMIN_GIN_PORT=9081
ADMIN_API_KEY=dev-notes-admin-key
