APP_ENV=dev
# LOG_LEVEL=debug

# Postgres from `make deps` (deploy/compose.yaml); use a role that is not a superuser
DB_DSN=postgres://note:note@localhost:5432/note?sslmode=disable
# auto: apply migrations then serve | only: apply and exit | off
# DB_MIGRATE=auto

GIN_PORT=3000
# GIN_MODE=release
# GIN_TRUSTED_PROXIES=10.0.0.0/8
# GIN_WRITE_TIMEOUT=0

# OpenTelemetry (traces + metrics over OTLP/gRPC, e.g. Grafana Alloy); empty disables export
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_TRACES_SAMPLER_ARG=1

# authorization: rbac (default, the service's RBAC policy) or rebac (the embedded
# ReBAC engine, tables in schema authz of this database). One model decides
# in both modes: authz/authz.yml.
# The engine records relationships either way, so switching needs no backfill.
# AUTHZ_ENFORCE=rbac

# admin API of the ReBAC engine (/admin/v1/authz), reached only through the
# gateway's admin API with the same key; empty disables it
ADMIN_API_KEY=dev-notes-admin-key

# callers are authenticated by the gateway's internal token (core/components/internalauthc):
# enforce (default) | permissive (headers accepted without a token, migrations only)
# | off (headers trusted: dev only, refused with APP_ENV=prd)
# INTERNAL_AUTH=enforce
# public keys of the gateway's internal tokens: its JWKS, or a directory of *.pem public keys
INTERNAL_JWT_JWKS_URL=http://localhost:9081/.well-known/internal-jwks.json
# INTERNAL_JWT_PUBLIC_KEYS_DIR=./internal-jwt-public-keys
# INTERNAL_JWT_ISSUER=saas-iam
# INTERNAL_JWT_AUDIENCE=<service name>
