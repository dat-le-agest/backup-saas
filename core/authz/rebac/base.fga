module base

# Base module of every model of core/authz/rebac, composed with the app's
# module(s): users and tenants with their roles. An app adds its type-level
# relations to tenant with `extend type tenant`.
#
# Naming convention (core/authz.DefaultRelations):
#   object-level  Check(action, {Type: t, ID: id})  →  t:id#can_<action>
#   type-level    Check(action, {Type: t})          →  tenant:<tenant>#can_<action>_<t>
#
# Tenant roles are never stored: every check adds the caller's role from their
# access token as a contextual tuple tenant:<id>#<role>@user:<id>.

type user

type tenant
  relations
    define owner: [user]
    define admin: [user] or owner
    define member: [user] or admin
    define viewer: [user] or member
